data/processed/*
!data/processed/.gitkeep
data/training/*
!data/training/.gitkeep

# Trained models (about 2.3 GB); metadata.json is tracked
ml/models/*.joblib
ml/runs/

# Logs and local reference material
logs/
docs/reference/

# Frontend
node_modules/
.next/

# Presentation build output
deck/
